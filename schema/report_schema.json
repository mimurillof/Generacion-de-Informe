{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report JSON Schema",
  "type": "object",
  "required": ["fileName", "content"],
  "additionalProperties": false,
  "properties": {
    "fileName": {"type": "string"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "author": {"type": "string"},
        "subject": {"type": "string"}
      }
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "text": {"type": "string"},
          "style": {"type": "string"},
          "height": {"type": ["number", "integer"]},
          "path": {"type": "string"},
          "caption": {"type": ["string", "null"]},
          "width": {"type": ["number", "integer", "null"]},
          "headers": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array", "items": {}}},
          "items": {"type": "array", "items": {}},
          "supabase": {"$ref": "#/definitions/supabase_image"}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "supabase_image": {
      "type": "object",
      "required": ["bucket", "path"],
      "properties": {
        "bucket": {"type": "string"},
        "path": {"type": "string"},
        "public": {"type": "boolean"},
        "expires_in": {"type": "integer"},
        "use_url": {"type": "boolean"},
        "transform": {
          "type": "object",
          "properties": {
            "width": {"type": "integer"},
            "height": {"type": "integer"},
            "quality": {"type": "integer", "minimum": 20, "maximum": 100},
            "resize": {"type": "string", "enum": ["cover", "contain", "fill"]},
            "format": {"type": "string", "enum": ["origin", "avif"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}


